+void Control::publishToolState() {
+    if (!this->toolStateSocket) {
+        return;
+    }
+
+    ToolType type = toolHandler->getToolType();
+    // Selection tools can carry TOOL_CAP_SIZE without a thickness table, so
+    // ask only for tools that draw.
+    bool draws = type == TOOL_PEN || type == TOOL_ERASER || type == TOOL_HIGHLIGHTER;
+    double thickness = draws ? toolHandler->getThickness() : 0.0;
+    Color color = toolHandler->hasCapability(TOOL_CAP_COLOR) ? toolHandler->getColor() : Color(0xff000000U);
+    double alpha = type == TOOL_HIGHLIGHTER ? xoj::view::StrokeView::OPACITY_HIGHLIGHTER : 1.0;
+    double zoomValue = this->zoom ? this->zoom->getZoom() : 1.0;
+
+    // g_ascii_formatd: the decimal separator must not follow the locale
+    char alphaStr[G_ASCII_DTOSTR_BUF_SIZE];
+    char thicknessStr[G_ASCII_DTOSTR_BUF_SIZE];
+    char zoomStr[G_ASCII_DTOSTR_BUF_SIZE];
+    g_ascii_formatd(alphaStr, sizeof(alphaStr), "%.3f", alpha);
+    g_ascii_formatd(thicknessStr, sizeof(thicknessStr), "%.4f", thickness);
+    g_ascii_formatd(zoomStr, sizeof(zoomStr), "%.4f", zoomValue);
+
+    char line[192];
+    g_snprintf(line, sizeof(line), "{\"tool\":\"%s\",\"color\":\"#%02x%02x%02x\",\"alpha\":%s,\"thickness\":%s,\"zoom\":%s}",
+               std::string(toolTypeToString(type)).c_str(), color.red, color.green, color.blue, alphaStr, thicknessStr,
+               zoomStr);
+    this->toolStateSocket->publish(line);
 }
 
