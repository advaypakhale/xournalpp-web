Build against FFmpeg 6.1's buffersink API as well as 7.1's.

av_opt_set_array and the "pixel_formats" option arrived in FFmpeg 7.1; Ubuntu
24.04 ships 6.1, where the equivalent is av_opt_set_bin on "pix_fmts".

diff --git a/lib/encode_video.c b/lib/encode_video.c
index 0d09b32..6885ba4 100644
--- a/lib/encode_video.c
+++ b/lib/encode_video.c
@@ -234,6 +234,7 @@ void init_scaler(
 		goto end;
 	}
 
+#if LIBAVFILTER_VERSION_INT >= AV_VERSION_INT(10, 4, 100)
 	ret = av_opt_set_array(
 		ctx->buffersink_scale_ctx,
 		"pixel_formats",
@@ -242,6 +243,15 @@ void init_scaler(
 		1,
 		AV_OPT_TYPE_PIXEL_FMT,
 		&pix_fmt_out);
+#else
+	/* pixel_formats and av_opt_set_array arrived in FFmpeg 7.1; Ubuntu 24.04 has 6.1. */
+	ret = av_opt_set_bin(
+		ctx->buffersink_scale_ctx,
+		"pix_fmts",
+		(const uint8_t*)&pix_fmt_out,
+		sizeof(pix_fmt_out),
+		AV_OPT_SEARCH_CHILDREN);
+#endif
 	if (ret < 0)
 	{
 		log_warn("Cannot set output pixel format: %s", av_err2str(ret));
