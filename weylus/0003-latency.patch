diff --git a/lib/encode_video.c b/lib/encode_video.c
index 6885ba4..aa41505 100644
--- a/lib/encode_video.c
+++ b/lib/encode_video.c
@@ -139,7 +139,10 @@ void set_codec_params(VideoContext* ctx)
 	ctx->c->time_base = TIME_BASE;
 	ctx->c->framerate = (AVRational){0, 1};
 
-	ctx->c->gop_size = 12;
+	// A keyframe every 12 frames is 2.5 IDRs/s at 30fps; each one is a
+	// bandwidth spike, and the client re-decodes from the last one whenever it
+	// seeks to the live edge. The stream is not seekable, so they buy nothing.
+	ctx->c->gop_size = 600;
 	// no B-frames to reduce latency
 	ctx->c->max_b_frames = 0;
 	if (ctx->oc->oformat->flags & AVFMT_GLOBALHEADER)
diff --git a/src/web.rs b/src/web.rs
index dc844d3..783ff7c 100644
--- a/src/web.rs
+++ b/src/web.rs
@@ -302,6 +302,12 @@ async fn run_server(
 
         debug!(address = ?remote_address, "Client connected.");
 
+        // Video frames are written as they are encoded; Nagle would hold each
+        // frame's tail until the peer acknowledges the previous one.
+        if let Err(err) = tcp.set_nodelay(true) {
+            warn!("Failed to set TCP_NODELAY: {err}.");
+        }
+
         let io = TokioIo::new(tcp);
 
         let sender_ui = sender_ui.clone();
