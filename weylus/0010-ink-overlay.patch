+    rect_y: number;
+    rect_w: number;
+    rect_h: number;
+    // capture instant of the newest painted frame, on performance.now()'s
+    // clock; -Infinity until a frame has been painted, which retires nothing
+    last_frame_at: number;
+    // whether the canvas currently sits on the capture's pixel grid
+    on_capture: boolean;
+    // the last blend mode and css box written to the element, so the style is
+    // only touched when it actually changes
+    blend: string;
+    box: string;
