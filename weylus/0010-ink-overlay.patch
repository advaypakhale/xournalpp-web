+    }
+
+    // StrokeHandler::paintTo
+    private paint_to(s: InkStroke, px: number, py: number, pz: number) {
+        if (s.has_pressure && pz > 0.0)
+            pz *= s.width;
+        let pts = s.points;
+        if (pts.length > 0) {
+            let end = pts[pts.length - 1];
+            let distance = Math.hypot(px - end.x, py - end.y);
+            if (distance < XPP_PIXEL_MOTION_THRESHOLD) {
+                // A rejected event still moved the stabilizer's mean; on top of
+                // that, while the stroke is a single point a rejected event can
+                // ratchet that point's width up, never down.
+                if (pts.length == 1 && s.has_pressure && end.z < pz) {
+                    end.z = pz;
+                    // the fattened dot is new ink, so restart its window
+                    end.t = s.stamp;
+                }
+                return;
+            }
+            if (s.has_pressure) {
+                let width_delta = pz - end.z;
+                if (-width_delta > XPP_MAX_WIDTH_VARIATION || width_delta > XPP_MAX_WIDTH_VARIATION) {
+                    let steps = Math.min(Math.ceil(Math.abs(width_delta) / XPP_MAX_WIDTH_VARIATION),
+                                         Math.floor(distance / XPP_PIXEL_MOTION_THRESHOLD));
+                    let step = 1 / steps;
+                    let ix = (px - end.x) * step;
+                    let iy = (py - end.y) * step;
+                    let iz = width_delta * step;
+                    // z runs one increment ahead of x and y: StrokeHandler.cpp
+                    // advances the width once before the loop and again inside
+                    // it. The bias is Xournal++'s and is reproduced on purpose.
+                    for (let i = 1; i < steps; i++)
+                        pts.push({
+                            x: end.x + i * ix,
+                            y: end.y + i * iy,
+                            z: end.z + (i + 1) * iz,
+                            t: s.stamp,
+                        });
+                }
+            }
+        }
+        pts.push({ x: px, y: py, z: s.has_pressure ? pz : XPP_NO_PRESSURE, t: s.stamp });
+    }
+
+    /* StrokeStabilizer::Active::quadraticSplineTo: on pen-up a quadratic spline
+     * closes the lag the averaging introduced, and the second-to-last point's
+     * width is rewritten. None of these points go through paintTo, so the
+     * admission threshold does not apply to them. */
+    private spline_tail(s: InkStroke, ev: number[]) {
+        let pts = s.points;
+        let n = pts.length;
+        if (n == 0)
+            return;
+        if (n == 1) {
+            this.paint_to(s, ev[0] / s.zoom, ev[1] / s.zoom, ev[2]);
+            return;
+        }
+        let B = { x: pts[n - 1].x, y: pts[n - 1].y, z: pts[n - 1].z, t: pts[n - 1].t };
+        let A = pts[n - 2];
+        let C = {
+            x: ev[0] / s.zoom,
+            y: ev[1] / s.zoom,
+            z: s.has_pressure ? ev[2] * s.width : XPP_NO_PRESSURE,
+            t: s.stamp,
+        };
+        let abx = B.x - A.x, aby = B.y - A.y;
+        let bcx = C.x - B.x, bcy = C.y - B.y;
+        let sq_bc = bcx * bcx + bcy * bcy;
+        let norm_bc = Math.sqrt(sq_bc);
+        let norm_ab = Math.hypot(abx, aby);
+        if (norm_bc < Number.EPSILON)
+            return;
+        if (norm_ab < Number.EPSILON) {
+            this.paint_to(s, ev[0] / s.zoom, ev[1] / s.zoom, ev[2]);
+            return;
+        }
+        let distance = Math.min(Math.abs(sq_bc * norm_ab / (2 * (abx * bcx + aby * bcy))), norm_bc);
+        if (s.has_pressure) {
+            let coeff = norm_bc / 2 + distance;
+            B.z = (coeff * A.z + norm_ab * C.z) / (norm_ab + coeff);
+            pts[n - 1].z = B.z;
+        }
+        let rel = (p: InkPoint, q: InkPoint, r: number) => ({
+            x: p.x + r * (q.x - p.x),
+            y: p.y + r * (q.y - p.y),
+            z: p.z + r * (q.z - p.z),
+            t: s.stamp,
+        });
+        let Q = rel(B, A, -distance / norm_ab);
+        let fp = rel(B, Q, 2 / 3);
+        let sp = rel(C, Q, 2 / 3);
+
+        let seq: InkPoint[] = [];
+        InkOverlay.point_sequence(B, fp, sp, C, s.has_pressure, seq);
+        for (let i = 1; i < seq.length; i++) {    // B has already been painted
+            seq[i].t = s.stamp;
+            pts.push(seq[i]);
+        }
+        pts.push(C);
+    }
+
+    // SplineSegment::toPointSequence, de Casteljau at t = 0.5
+    private static point_sequence(k0: InkPoint, c0: InkPoint, c1: InkPoint, k1: InkPoint,
+                                  use_pressure: boolean, out: InkPoint[]) {
+        let l1 = Math.hypot(k0.x - c0.x, k0.y - c0.y);
+        let l2 = Math.hypot(c0.x - c1.x, c0.y - c1.y);
+        let l3 = Math.hypot(c1.x - k1.x, c1.y - k1.y);
+        let l = Math.hypot(k0.x - k1.x, k0.y - k1.y);
+        if (l < XPP_SPLINE_MIN_KNOT_DISTANCE
+            || (l1 + l2 + l3 < XPP_SPLINE_FLATNESS_TOLERANCE * l
+                && (!use_pressure || Math.abs(k0.z - k1.z) <= XPP_SPLINE_MAX_WIDTH_VARIATION))) {
+            out.push(k0);
+            return;
+        }
+        let mid = (p: InkPoint, q: InkPoint) => ({
+            x: (p.x + q.x) / 2,
+            y: (p.y + q.y) / 2,
+            z: XPP_NO_PRESSURE,             // only knot widths are ever read
+            t: 0,                           // stamped by the caller if emitted
+        });
+        let b0 = mid(k0, c0), b1 = mid(c0, c1), b2 = mid(c1, k1);
+        let e0 = mid(b0, b1), e1 = mid(b1, b2);
+        let d0 = mid(e0, e1);
+        // At t = 0.5 the inverted weights in SplineSegment::subdivide reduce to
+        // the midpoint, so the apparent bug there is inert.
+        if (use_pressure)
+            d0.z = 0.5 * k0.z + 0.5 * k1.z;
+        InkOverlay.point_sequence(k0, b0, e0, d0, use_pressure, out);
+        InkOverlay.point_sequence(d0, e1, b2, k1, use_pressure, out);
+    }
+
+    /* The region Xournal++ fills is exactly the union of one capsule per
+     * segment, each at the CONSTANT radius of half its FIRST point's width:
+     * the width is never interpolated along a segment, and the last point's
+     * width is never read at all — the end cap takes its radius from the
+     * point before it. Getting that wrong is what tapers the pen tip.
+     *
+     * All the capsules go into one path and are filled once with the nonzero
+     * winding rule, which unions them. Filling them one at a time would
+     * composite their antialiased edges together and fatten every joint.
+     *
+     * Each capsule starts on its own circle rather than at its centre: arc()
+     * prepends a line from the current point, and closePath() returns to the
+     * subpath's start, so starting at the centre cuts a wedge out of the
+     * capsule.
+     *
+     * Only the segments not yet in the path are appended. A segment is final as
+     * soon as the point after it exists: it takes its radius from its own first
+     * point, and the two places that rewrite a width — the thickened first point
+     * and the spline tail's rewrite of the last one — both touch a point no
+     * segment has been emitted for yet. */
+    private static contour(s: InkStroke): Path2D {
+        let pts = s.points;
+        let path = s.path;
+        if (s.built == 0 && pts.length == 2 && pts[0].x == pts[1].x && pts[0].y == pts[1].y) {
+            path.arc(pts[0].x, pts[0].y, 0.5 * pts[0].z, 0, 2 * Math.PI);
+            s.built = 1;
+            return path;
+        }
+        for (let i = s.built; i + 1 < pts.length; i++) {
+            let a = pts[i], b = pts[i + 1], r = 0.5 * a.z;
+            if (!(r > 0))
+                continue;
+            let dx = b.x - a.x, dy = b.y - a.y;
+            let len = Math.hypot(dx, dy);
+            if (len == 0) {
+                path.moveTo(a.x + r, a.y);
+                path.arc(a.x, a.y, r, 0, 2 * Math.PI, false);
+                path.closePath();
+                continue;
+            }
+            let th = Math.atan2(dy, dx);
+            let start = th + Math.PI / 2, end = th - Math.PI / 2;
+            path.moveTo(a.x + r * Math.cos(start), a.y + r * Math.sin(start));
+            path.arc(a.x, a.y, r, start, end, false);
+            path.arc(b.x, b.y, r, end, start, false);
+            path.closePath();
+        }
+        s.built = pts.length - 1;
+        return path;
+    }
+
+    render() {
+        requestAnimationFrame(() => this.render());
+        let now = performance.now();
+        let cutoff = this.cutoff();
+        /* A finished stroke is kept until the video has caught up with its last
+         * point, however long that takes. The cap only bites if frames stop
+         * arriving altogether, and then holding on to strokes forever would be
+         * a leak on top of an already broken picture. */
+        let live = (s: InkStroke) => s.done_at == 0
+            || (s.points[s.points.length - 1].t >= cutoff && now - s.done_at <= INK_MAX_HOLD);
+        if (!this.strokes.every(live))
+            this.strokes = this.strokes.filter(live);
