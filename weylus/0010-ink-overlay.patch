+        // ramp-up: the first motion point sits two thirds of the way back.
+        for (let i = 0; i < XPP_STABILIZER_BUFSIZE; i++)
+            s.buf.push([pos[0], pos[1], pressure]);
+
+        this.strokes.push(s);
+        this.active.set(id, s);
+    }
+
+    private motion(s: InkStroke, event: PointerEvent) {
+        s.stamp = event.timeStamp;
+        let pos = this.wire_pos(s, event);
+        let pressure = this.filter_pressure(s, this.wire_pressure(event));
+        if (pressure == 0)
+            return;                         // StrokeHandler.cpp:61
+        s.buf.unshift([pos[0], pos[1], pressure]);
+        s.buf.length = XPP_STABILIZER_BUFSIZE;
+        let x = 0, y = 0, p = 0;
+        for (const e of s.buf) {
+            x += e[0];
+            y += e[1];
+            p += e[2];
+        }
+        let d = XPP_STABILIZER_BUFSIZE;
+        this.paint_to(s, x / d / s.zoom, y / d / s.zoom, p / d);
+    }
+
+    private finish(id: number, event: PointerEvent) {
+        let s = this.active.get(id);
+        if (!s)
+            return;
+        this.active.delete(id);
+        s.stamp = event.timeStamp;
+        // The release event is filtered but never enters the stabilizer, so the
+        // spline tail runs to the newest raw motion event still in the buffer.
+        let release = this.filter_pressure(s, this.wire_pressure(event));
+        this.spline_tail(s, s.buf[0]);
