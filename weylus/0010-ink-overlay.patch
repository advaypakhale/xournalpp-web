+const XPP_SPLINE_MIN_KNOT_DISTANCE = 0.3;   // SplineSegment::MIN_KNOT_DISTANCE
+const XPP_SPLINE_FLATNESS_TOLERANCE = 1.0001;
+const XPP_SPLINE_MAX_WIDTH_VARIATION = 0.1;
+const XPP_NO_PRESSURE = -1;                 // Point::NO_PRESSURE
+// Full scale of the uinput absolute axes the pen events are sent on.
+const WIRE_ABS_MAX = 65535;
+
+/* Fallback for the Echo hold slider, in milliseconds; keep it in step with the
+ * slider's own default. InkOverlay.cutoff says what the hold covers. */
