+    x: number;
+    y: number;
+    // stroke diameter at this point, in document units; -1 means "no pressure"
+    z: number;
+    // timestamp of the event that produced the point, on performance.now()'s
+    // clock, so the point can be dropped once a frame proves the video is
+    // showing it
+    t: number;
+}
+
