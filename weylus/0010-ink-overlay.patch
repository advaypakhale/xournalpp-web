+        let ctx = this.ctx;
+        this.apply_blend();
+        if (!this.enabled() || this.strokes.length == 0 || this.rect_w <= 0 || this.rect_h <= 0) {
+            if (!this.was_clear) {
+                ctx.setTransform(1, 0, 0, 1, 0, 0);
+                ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
+                this.was_clear = true;
+            }
+            return;
+        }
+        let on_capture = this.layout();
+
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
+        let dpr = window.devicePixelRatio;
+        let drew = false;
+        for (const s of this.strokes) {
+            let pts = s.points;
+            let n = pts.length;
+            if (n == 0 || pts[n - 1].t < cutoff)
+                continue;                   // the video already has all of it
+
+            // Document units to canvas pixels. x and y scale independently
+            // because the video box does: the real ink is stretched by the same
+            // factors on its way to the screen, round caps and all. On the
+            // capture grid that stretch is the element's, so only the capture
+            // size the stroke was started under is left to correct for.
+            let sx: number, sy: number, ox: number, oy: number;
+            if (on_capture) {
+                sx = s.zoom * this.capture_width / s.cap_w;
+                sy = s.zoom * this.capture_height / s.cap_h;
+                ox = oy = 0;
+            } else {
+                sx = dpr * s.zoom * this.rect_w / s.cap_w;
+                sy = dpr * s.zoom * this.rect_h / s.cap_h;
+                ox = dpr * this.rect_x;
+                oy = dpr * this.rect_y;
+            }
+            ctx.setTransform(sx, 0, 0, sy, ox, oy);
+            ctx.globalAlpha = s.alpha;
+            drew = true;
+            if (s.has_pressure) {
+                ctx.fillStyle = s.color;
+                if (n == 1) {
+                    // StrokeToolView::drawDot: a round-capped zero-length
+                    // stroke, which is a disc
+                    let p = pts[0];
+                    let dot = new Path2D();
+                    dot.arc(p.x, p.y, 0.5 * p.z, 0, 2 * Math.PI);
+                    ctx.fill(dot, "nonzero");
+                } else {
+                    ctx.fill(InkOverlay.contour(s), "nonzero");
+                }
+            } else {
+                // StrokeViewHelper::drawNoPressure: a plain polyline stroked at
+                // the tool's width, round cap and round join
+                ctx.strokeStyle = s.color;
+                ctx.lineWidth = s.width;
+                ctx.lineCap = "round";
+                ctx.lineJoin = "round";
+                ctx.beginPath();
+                ctx.moveTo(pts[0].x, pts[0].y);
+                for (let i = 1; i < n; i++)
+                    ctx.lineTo(pts[i].x, pts[i].y);
+                if (n == 1)
+                    ctx.lineTo(pts[0].x, pts[0].y);
+                ctx.stroke();
+            }
+        }
+        ctx.globalAlpha = 1;
+        this.was_clear = !drew;
+    }
