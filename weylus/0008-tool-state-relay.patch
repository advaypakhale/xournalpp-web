+/// Forwards newline-delimited messages from a unix socket to one websocket
+/// client. Retries with backoff while the socket does not exist and reconnects
+/// when the peer goes away; exits once the websocket client is gone. Knows
+/// nothing about the payload.
+#[cfg(target_os = "linux")]
+pub fn relay_tool_state(path: std::path::PathBuf, sender: WsWeylusSender) {
+    use std::io::{BufRead, BufReader, ErrorKind};
+    use std::os::unix::net::UnixStream;
+
+    const BACKOFF_START: Duration = Duration::from_millis(250);
+    const BACKOFF_MAX: Duration = Duration::from_secs(2);
+
+    let mut backoff = BACKOFF_START;
+    'reconnect: loop {
+        if sender.sender.is_closed() {
+            return;
+        }
+        let stream = match UnixStream::connect(&path) {
+            Ok(stream) => stream,
+            Err(_) => {
+                std::thread::sleep(backoff);
+                backoff = (backoff * 2).min(BACKOFF_MAX);
+                continue;
+            }
+        };
+        backoff = BACKOFF_START;
+        // A finite read timeout lets the loop notice a vanished websocket
+        // client even while the tool state is silent.
+        if stream
+            .set_read_timeout(Some(Duration::from_secs(2)))
+            .is_err()
+        {
+            continue;
+        }
+        let mut reader = BufReader::new(stream);
+        let mut line = String::new();
+        loop {
+            if sender.sender.is_closed() {
+                return;
+            }
+            match reader.read_line(&mut line) {
+                Ok(0) => continue 'reconnect,
+                Ok(_) => {
+                    let msg = line.trim_end().to_string();
+                    line.clear();
+                    if !msg.is_empty()
+                        && sender
+                            .sender
+                            .blocking_send(WsMessage::MessageOutbound(MessageOutbound::ToolState(
+                                msg,
+                            )))
+                            .is_err()
+                    {
+                        return;
+                    }
+                }
+                // partial data before the timeout stays in `line`
+                Err(err)
+                    if matches!(
+                        err.kind(),
+                        ErrorKind::WouldBlock | ErrorKind::TimedOut | ErrorKind::Interrupted
+                    ) =>
+                {
+                    continue
+                }
+                Err(_) => continue 'reconnect,
+            }
+        }
+    }
+}
