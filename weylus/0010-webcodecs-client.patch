+/* The codec string a VideoDecoder has to be configured with, read out of the
+ * stream itself. avc1.PPCCLL is the profile, the constraint flags and the
+ * level: the three bytes that follow the NAL header of the sequence parameter
+ * set. The server picks its encoder and its profile at run time, so anything
+ * hardcoded here would be a bug waiting for someone to turn on VAAPI.
+ *
+ * Returns null if the frame carries no SPS. */
+function codec_from_annexb(data: Uint8Array): string {
+    let zeros = 0;
+    for (let i = 0; i + 4 < data.length; i++) {
+        if (data[i] == 0) {
+            zeros++;
+            continue;
+        }
+        // A start code is two or more zero bytes and a one. What follows is the
+        // NAL header, whose low five bits are the type; 7 is the SPS.
+        if (data[i] == 1 && zeros >= 2 && (data[i + 1] & 0x1f) == 7) {
+            let hex = "";
+            for (let j = i + 2; j <= i + 4; j++)
+                hex += data[j].toString(16).padStart(2, "0");
+            return "avc1." + hex.toUpperCase();
+        }
+        zeros = 0;
+    }
+    return null;
