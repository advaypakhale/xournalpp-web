+
+// The X display and capturable inside are only ever used by the thread holding the mutex in
+// SharedUInputDevice, which is what makes moving them between threads sound.
+unsafe impl Send for UInputDevice {}
+
+/// One set of uinput devices used by every client, created before any client connects.
+pub struct SharedUInputDevice(pub Arc<Mutex<UInputDevice>>);
+
+impl InputDevice for SharedUInputDevice {
+    fn send_wheel_event(&mut self, event: &WheelEvent) {
+        self.0.lock().unwrap().send_wheel_event(event)
+    }
+
+    fn send_pointer_event(&mut self, event: &PointerEvent) {
+        self.0.lock().unwrap().send_pointer_event(event)
+    }
+
+    fn send_keyboard_event(&mut self, event: &KeyboardEvent) {
+        self.0.lock().unwrap().send_keyboard_event(event)
+    }
+
+    fn set_capturable(&mut self, capturable: Box<dyn Capturable>) {
+        self.0.lock().unwrap().set_capturable(capturable)
     }
 
