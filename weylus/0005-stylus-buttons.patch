+
+    // Emits BTN_STYLUS/BTN_STYLUS2 transitions so the barrel buttons match
+    // `buttons` (the browser's currently-held set). Idempotent; called with
+    // Button::NONE to force a release when the pen leaves proximity.
+    fn sync_stylus_buttons(&mut self, buttons: Button) {
+        let desired = buttons & (Button::SECONDARY | Button::AUXILARY);
+        // A Wacom pen's lower barrel button reaches the browser as the
+        // auxiliary button and the upper one as the secondary button, which is
+        // the opposite of what their evdev codes suggest.
+        for (flag, code) in [
+            (Button::AUXILARY, EC_KEY_STYLUS),
+            (Button::SECONDARY, EC_KEY_STYLUS2),
+        ] {
+            let want = desired.contains(flag);
+            if want != self.stylus_buttons.contains(flag) {
+                self.send(self.stylus_fd, ET_KEY, code, want as c_int);
+            }
+        }
+        self.stylus_buttons = desired;
+    }
 }
 
