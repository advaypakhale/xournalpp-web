+/* One frame per websocket message: a flags byte, then the capture timestamp as
+ * a little-endian u64 of microseconds on the server's monotonic clock, then the
+ * frame's H.264 bytes. */
+const VIDEO_HEADER_LEN = 9;
+const VIDEO_FLAG_KEYFRAME = 1;
+
+/* Maps the server's monotonic clock onto performance.now().
+ *
+ * A frame turns up at (capture + offset + delivery), where delivery is the
+ * encoding, the socket and the network, and is never negative. The smallest
+ * (arrival - capture) seen recently is therefore as close to the offset as this
+ * connection gets without a protocol round trip, and it overstates it by
+ * whatever the quickest delivery cost. Overstating the offset makes the ink
+ * echo retire points early, which is the failure that shows as a gap behind the
+ * pen, so the caller subtracts a margin on top of this.
+ *
+ * Two buckets take turns and the estimate is the smaller of the two, so a
+ * window of one to two bucket lengths is always in play. Rotating them lets the
+ * estimate follow the drift between two machines' monotonic clocks instead of
+ * latching onto one lucky frame for the life of the connection. */
+class VideoClock {
+    private static BUCKET_MS = 5000;
+    private cur: number;
+    private prev: number;
+    private rotate_at: number;
+
+    constructor() {
+        this.cur = Infinity;
+        this.prev = Infinity;
+        this.rotate_at = -Infinity;
+    }
+
+    sample(arrival_ms: number, capture_ms: number) {
+        if (arrival_ms >= this.rotate_at) {
+            this.prev = this.cur;
+            this.cur = Infinity;
+            this.rotate_at = arrival_ms + VideoClock.BUCKET_MS;
+        }
+        this.cur = Math.min(this.cur, arrival_ms - capture_ms);
+    }
+
+    // milliseconds to add to a server timestamp, or null until a frame arrives
+    offset(): number {
+        let o = Math.min(this.cur, this.prev);
+        return isFinite(o) ? o : null;
+    }
