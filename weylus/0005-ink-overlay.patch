+        // out regardless; dropping the state here merely frees it early and
+        // separates strokes of a reused pointer id.
+        if (event_type != "pointerdown" && event_type != "pointermove") {
+            this.active.delete(id);
+            this.raw.delete(id);
+            return;
+        }
+        if (!this.enabled())
+            return;
+        // Only the pen tip and the left mouse button leave ink: the barrel
+        // button and the eraser tip make Xournal++ switch tools.
+        if (event.buttons != 1 || (event.pointerType != "pen" && event.pointerType != "mouse")) {
+            this.active.delete(id);
+            this.raw.delete(id);
+            return;
+        }
+
+        let pressure = Math.max(event.pressure, settings.range_min_pressure.valueAsNumber);
+        // Xournal++'s pressure pipeline with the settings used on the server:
+        // minimumPressure = 0.09, pressureMultiplier = 1.6 (PenInputHandler).
+        pressure = Math.max(0.09, pressure * 1.6);
+
+        let buf = this.raw.get(id);
+        let stroke = this.active.get(id);
+        if (event_type == "pointerdown" || !buf || !stroke) {
+            buf = [];
+            this.raw.set(id, buf);
+            stroke = new InkStroke();
+            this.strokes.push(stroke);
+            this.active.set(id, stroke);
+        }
