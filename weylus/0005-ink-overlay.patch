+        for (const [bx, by, bp] of buf) {
+            x += bx;
+            y += by;
+            p += bp;
+        }
+        let n = buf.length;
+        stroke.points.push({
+            x: x / n,
+            y: y / n,
+            w: p / n * settings.ink_thickness_input.valueAsNumber,
