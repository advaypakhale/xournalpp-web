+/* Echoes pen input on a transparent canvas above the video while the real ink
+ * makes the round trip through the server. Only the trailing "Latency window"
+ * milliseconds of each stroke are drawn; older parts are assumed to be visible
+ * in the video underneath, so the tail simply runs out and no retire event is
+ * needed. The stroke geometry imitates Xournal++'s pen rendering so the echo
+ * and the video ink line up. */
+class InkOverlay {
+    canvas: HTMLCanvasElement;
+    ctx: CanvasRenderingContext2D;
+    strokes: InkStroke[];
+    active: Map<number, InkStroke>;
+    // per-pointer [x, y, pressure] input history for the stabilizer
+    raw: Map<number, [number, number, number][]>;
+    was_clear: boolean;
+
+    constructor(canvas: HTMLCanvasElement) {
+        this.canvas = canvas;
+        this.ctx = canvas.getContext("2d");
+        this.strokes = [];
+        this.active = new Map();
+        this.raw = new Map();
+        this.was_clear = true;
+        this.resize();
+        window.addEventListener("resize", () => this.resize());
+        requestAnimationFrame(() => this.render());
+    }
+
+    resize() {
+        this.canvas.width = window.innerWidth * window.devicePixelRatio;
+        this.canvas.height = window.innerHeight * window.devicePixelRatio;
+    }
+
+    enabled(): boolean {
