diff --git a/lib/encode_video.c b/lib/encode_video.c
index aa41505..c1b6236 100644
--- a/lib/encode_video.c
+++ b/lib/encode_video.c
@@ -139,10 +139,11 @@ void set_codec_params(VideoContext* ctx)
 	ctx->c->time_base = TIME_BASE;
 	ctx->c->framerate = (AVRational){0, 1};
 
-	// A keyframe every 12 frames is 2.5 IDRs/s at 30fps; each one is a
-	// bandwidth spike, and the client re-decodes from the last one whenever it
-	// seeks to the live edge. The stream is not seekable, so they buy nothing.
-	ctx->c->gop_size = 600;
+	// Upstream's 12 puts an IDR on the wire 2.5 times a second, each one a
+	// bandwidth spike. The stream is only ever played live, so keyframes are
+	// needed just often enough to keep the fallback seek from re-decoding a
+	// long run of frames.
+	ctx->c->gop_size = 120;
 	// no B-frames to reduce latency
 	ctx->c->max_b_frames = 0;
 	if (ctx->oc->oformat->flags & AVFMT_GLOBALHEADER)
