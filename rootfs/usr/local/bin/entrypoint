#!/bin/bash
# Order matters: the uinput devices must exist before Xorg starts, because
# without udev Xorg only picks up the devices named in its config.
set -euo pipefail

WIDTH=${SCREEN%x*}
HEIGHT=${SCREEN#*x}

# Xournal++ publishes its tool state here; Weylus relays it to the browser so
# the local ink overlay can match the real ink. Weylus starts first and
# reconnects until Xournal++ is up.
export XOURNALPP_TOOL_SOCKET=/run/xournalpp-tool.sock

mkdir -p /data/notes "$XDG_CONFIG_HOME/xournalpp" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" /tmp/.X11-unix
chmod 1777 /tmp/.X11-unix

# Copied, not linked: Xournal++ rewrites settings.xml on every change.
if [ -d /seed ]; then
    cp -n /seed/* "$XDG_CONFIG_HOME/xournalpp/" 2>/dev/null || true
fi

cleanup() {
    trap - TERM INT
    kill 0 2>/dev/null || true
}
trap cleanup TERM INT

# Killing the container leaves an emergency save behind, and Xournal++ then
# offers to restore it in a modal dialog that holds the keyboard until it is
# answered. Keep the file as an ordinary document instead, so every restart
# comes up ready to draw on.
emergency="$XDG_CONFIG_HOME/xournalpp/emergencysave.xopp"
if [ -e "$emergency" ]; then
    mv "$emergency" "/data/notes/recovered-$(date +%Y%m%d-%H%M%S).xopp"
fi

weylus_nodes() {
    local dev
    for dev in /sys/class/input/event*; do
        case "$(cat "$dev/device/name" 2>/dev/null)" in
            Weylus*) echo "${dev##*/}" ;;
        esac
    done
}

# Every container names its uinput devices identically and they all share the
# host's /dev/input, so a name alone does not say which container a device
# belongs to. Anything already present belongs to somebody else; ours are the
# nodes that appear after this weylus starts.
FOREIGN=$(weylus_nodes)

weylus --no-gui --precreate-uinput --bind-address 0.0.0.0 --web-port 1701 \
    --tool-state-socket "$XOURNALPP_TOOL_SOCKET" \
    ${WEYLUS_ACCESS_CODE:+--access-code "$WEYLUS_ACCESS_CODE"} &

is_foreign() {
    local node
    for node in $FOREIGN; do
        if [ "$node" = "$1" ]; then
            return 0
        fi
    done
    return 1
}

event_node() {
    local dev
    for dev in /sys/class/input/event*; do
        if [ "$(cat "$dev/device/name" 2>/dev/null)" = "$1" ] && ! is_foreign "${dev##*/}"; then
            echo "/dev/input/${dev##*/}"
            return 0
        fi
    done
    return 1
}

for _ in $(seq 1 100); do
    if STYLUS=$(event_node "Weylus Stylus") && MOUSE=$(event_node "Weylus Mouse") \
        && TOUCH=$(event_node "Weylus Touch") && KEYBOARD=$(event_node "Weylus Keyboard") \
        && [ -e "$STYLUS" ] && [ -e "$MOUSE" ] && [ -e "$TOUCH" ] && [ -e "$KEYBOARD" ]; then
        break
    fi
    sleep 0.1
done
[ -e "${KEYBOARD:-}" ] || { echo "uinput devices did not appear" >&2; exit 1; }

MODELINE=$(gtf "$WIDTH" "$HEIGHT" 60 | grep Modeline | sed "s/^ *//")
MODE=$(echo "$MODELINE" | cut -d'"' -f2)
sed -e "s|@MODELINE@|$MODELINE|" -e "s|@MODE@|$MODE|" \
    -e "s|@WIDTH@|$WIDTH|" -e "s|@HEIGHT@|$HEIGHT|" \
    -e "s|@STYLUS@|$STYLUS|" -e "s|@MOUSE@|$MOUSE|" \
    -e "s|@TOUCH@|$TOUCH|" -e "s|@KEYBOARD@|$KEYBOARD|" \
    /etc/X11/xorg.conf.in > /run/xorg.conf

Xorg "$DISPLAY" -config /run/xorg.conf -noreset -nolisten tcp -novtswitch -sharevts \
    -logfile /tmp/Xorg.log &

for _ in $(seq 1 100); do
    xset -q >/dev/null 2>&1 && break
    sleep 0.1
done
xset -q >/dev/null || { echo "Xorg did not start" >&2; exit 1; }
xsetroot -solid '#333333'
# Without a window manager GTK cannot maximise, so the window stays at its
# default size. matchbox fills the screen with every top-level window.
matchbox-window-manager -use_titlebar no -use_cursor yes &

cd /data/notes
while true; do
    xournalpp ${XOURNALPP_FILE:+"$XOURNALPP_FILE"} || true
    sleep 1
done &

wait -n
exit 1
